    "features": [
      {
        "level": 1,
        "name": "Spellcasting, Tinker's Magic",
        "description": "Intelligence spellcasting, two chosen cantrips plus Mending, and prepared Artificer spells. Tinker magic creates temporary mundane gear; uses equal Intelligence modifier, minimum one, per long rest."
      },
      {
        "level": 2,
        "name": "Replicate Magic Item",
        "description": "Learn eligible magic-item plans and create a limited number of replicated items. Record each created item in Equipment and apply item-specific bonuses in Feats & bonuses."
      },
      {
        "level": 3,
        "name": "Artificer Subclass",
        "description": "Choose an Artificer specialty and review its companion, equipment and spell rules."
      },
      {
        "level": 6,
        "name": "Magic Item Tinker",
        "description": "Magic Item Tinker provides charging, draining and transmutation options for replicated items. Resolve item and spell-slot transactions when used."
      },
      {
        "level": 7,
        "name": "Flash of Genius",
        "description": "Flash of Genius helps a failed ability check or saving throw with Intelligence; track expended uses in class resources."
      },
      {
        "level": 10,
        "name": "Magic Item Adept",
        "description": "The attunement limit increases to four."
      },
      {
        "level": 11,
        "name": "Spell-Storing Item",
        "description": "Spell-Storing Item holds an eligible Artificer spell of up to level 3; resolve its uses and restrictions separately."
      },
      {
        "level": 14,
        "name": "Advanced Artifice",
        "description": "Advanced Artifice increases the attunement limit to five and restores one Flash of Genius on a short rest."
      },
      {
        "level": 18,
        "name": "Magic Item Master",
        "description": "Magic Item Master increases the attunement limit to six."
      },
      {
        "level": 19,
        "name": "Epic Boon",
        "description": "Choose an Epic Boon or another eligible feat."
      },
      {
        "level": 20,
        "name": "Soul of Artifice",
        "description": "Soul of Artifice offers item-fueled survival and improved recovery of Flash of Genius. Track attuned and replicated items to determine eligibility."
      }
    ],
    "reference": "Eberron: Forge of the Artificer (2025). Original app summaries; consult the book for full item, tool and spell rules.",
    "source": "https://www.dndbeyond.com/posts/2106-whats-new-with-the-artificer-in-eberron-forge-of"
  },
